# Source allowlist: personal assets and runtime data stay on this PC.
/*
!/.gitignore
!/README.md
!/*.py
!/requirements*.txt
!/*.bat
!/*.ps1
!/*.command
!/docs/
/docs/*
!/docs/*.md
!/personality/
/personality/*
!/personality/sakura.txt
!/launcher/
/launcher/*
!/launcher/*.cs
!/launcher/*.py
!/launcher/*.ico
!/tools/
/tools/*
!/tools/*.py
!/tools/*.cjs
!/tools/*.js
!/tools/*.ps1
!/tools/*.bat
!/tests/
/tests/*
!/tests/*.py
!/tests/*.cjs
!/tests/*.js
!/tests/*.cs
!/static/
!/static/**

# Never commit secrets, generated files or imported model/voice weights.
**/__pycache__/
**/node_modules/
**/.env
**/.env.*
**/*.pyc
**/*.pyo
**/*.log
**/*.exe
**/*.dll
**/*.zip
**/*.dmg
**/*.pmx
**/*.pmd
**/*.vrm
**/*.moc3
**/*.gguf
**/*.safetensors
**/*.pth
**/*.onnx
**/*-key.bin
**/settings.json
**/conversation-memory.json
**/steam-shortcuts.json
**/.DS_Store
